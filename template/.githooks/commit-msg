#!/usr/bin/env sh
# commit-msg hook: reject a Co-Authored-By or Claude-Session trailer line,
# then run commitlint when the project has it (node_modules/.bin/commitlint
# present). Runs commitlint through `mise exec -- pnpm exec` only once mise
# itself resolves pnpm for this project; otherwise execs the commitlint
# shim directly. Execs neither mise nor pnpm when commitlint is absent.
set -eu

msg_file="$1"

trailer=$(grep -iE '^(Co-Authored-By|Claude-Session):' "$msg_file" | head -n1)
if [ -n "$trailer" ]; then
  echo "commit-msg: trailer not allowed: ${trailer%%:*}" >&2
  exit 1
fi

if [ -x "node_modules/.bin/commitlint" ]; then
  if command -v mise >/dev/null 2>&1 && mise which pnpm >/dev/null 2>&1; then
    exec mise exec -- pnpm exec commitlint --edit "$msg_file"
  fi
  exec node_modules/.bin/commitlint --edit "$msg_file"
fi
