{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge topic file",
  "description": "One file per topic. Entries are addressable by id (<topic>.<slug>). To add an area, extend $defs.area.enum here and knowledge/areas.json together.",
  "type": "object",
  "required": [
    "topic",
    "title",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "kind": {
      "enum": [
        "rule",
        "invariant",
        "gotcha",
        "procedure",
        "decision",
        "history"
      ]
    },
    "area": {
      "enum": [
        "global",
        "process",
        "docs",
        "tools"
      ]
    },
    "glob": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "paths"
        ],
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "type",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "grep-absent",
            "commits",
            "co-change",
            "diff-append-only",
            "report-field"
          ]
        },
        "level": {
          "enum": [
            "fail",
            "warn"
          ]
        },
        "files": {
          "$ref": "#/$defs/glob"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "changed",
            "tree"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "body_absent": {
          "type": "string",
          "minLength": 1
        },
        "if": {
          "$ref": "#/$defs/glob"
        },
        "then": {
          "$ref": "#/$defs/glob"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "area",
        "summary",
        "body",
        "tags",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "area": {
          "$ref": "#/$defs/area"
        },
        "standing": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "uniqueItems": true
        },
        "source": {
          "type": "object",
          "required": [
            "date",
            "by"
          ],
          "additionalProperties": false,
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "by": {
              "enum": [
                "user",
                "review",
                "controller",
                "docs"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "see": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verify": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "check": {
          "$ref": "#/$defs/check"
        }
      }
    }
  }
}
