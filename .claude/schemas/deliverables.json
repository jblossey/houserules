{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent deliverables",
  "description": "Task reports, task reviews, re-reviews, branch reviews, and spec reviews written by the agent templates in .claude/agents/, which `houserules init --workflow reference` installs. The `kind` field selects the definition. Every kind records the `model` that wrote it. Validate with houserules validate <file>.",
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "backlogId": {
      "type": "string",
      "pattern": "^(HR-[0-9]+|A-[0-9]+|PP-[0-9]+-[0-9]+)$"
    },
    "model": {
      "description": "The model that wrote the deliverable: the value that its task names (a model alias or a model id), `human`, or `unknown`.",
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "textList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "prose": {
      "type": "string",
      "minLength": 3
    },
    "proseList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prose"
      }
    },
    "taskNumber": {
      "description": "A task-report/task-review/re-review's own `task` field value: an integer or a free-form string naming the task to a human reader. Governs that field's value, not a deliverable filename -- see taskId for the filename's own, narrower shape.",
      "type": [
        "integer",
        "string"
      ]
    },
    "taskId": {
      "description": "The task-id segment of a deliverable filename (task-<id>-report.json, task-<id>-audit*.json, task-<id>-review*.json): digits, with an optional trailing lowercase letter for a split task. This is the task-id shape the houserules binary's deliverable filename patterns use, distinct from taskNumber's free-form field value.",
      "type": "string",
      "pattern": "^\\d+[a-z]?$"
    },
    "commit": {
      "type": "object",
      "required": [
        "sha",
        "subject"
      ],
      "additionalProperties": false,
      "properties": {
        "sha": {
          "$ref": "#/$defs/sha"
        },
        "subject": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "sha256Hex": {
      "description": "A SHA-256 digest: 64 lowercase hexadecimal digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run": {
      "description": "One run of a command that the report cites. The run names its capture, a file that `houserules capture` wrote: a header line, then the output of the command. `sha256` is the hash of the whole capture file. The report holds no command output inline: the capture is the full evidence, and the report stays small. `command` and `exit` repeat the header of the capture, and `houserules report-facts` fills them and `sha256`. `excerpt` is optional: a short part of the output that a reader needs at once, copied byte for byte. It holds at most 1000 UTF-16 code units (the unit of `maxLength`), because a longer part belongs in the capture.",
      "type": "object",
      "required": [
        "capture",
        "sha256",
        "command",
        "exit"
      ],
      "additionalProperties": false,
      "properties": {
        "capture": {
          "description": "The path of the capture file: absolute, or relative to the install root.",
          "$ref": "#/$defs/text"
        },
        "sha256": {
          "description": "The SHA-256 of the whole capture file.",
          "$ref": "#/$defs/sha256Hex"
        },
        "command": {
          "description": "The `argv` of the capture header, joined for a POSIX shell.",
          "$ref": "#/$defs/text"
        },
        "exit": {
          "description": "The `exit` of the capture header: the exit code, or `null` when a signal ended the command.",
          "type": [
            "integer",
            "null"
          ]
        },
        "excerpt": {
          "description": "A part of the output of the capture, byte for byte: 1 to 1000 UTF-16 code units.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "selfReviewItem": {
      "description": "One claim of the self-review, with the evidence for it. A claim that states a closed set (every, all, no remaining) lists a capture as its evidence, and a claim that states a pinned behavior lists an existing path.",
      "type": "object",
      "required": [
        "claim"
      ],
      "additionalProperties": false,
      "properties": {
        "claim": {
          "$ref": "#/$defs/prose"
        },
        "evidence": {
          "description": "The paths that show the claim, each absolute or relative to the install root, with no line suffix.",
          "$ref": "#/$defs/textList"
        }
      }
    },
    "citation": {
      "description": "A line, or a range of lines, of a file at HEAD that a claim of the report rests on. `anchor` is text of the cited lines, copied byte for byte, that occurs once in the file and holds three non-whitespace characters in a row. `sha256` is the hash of the cited lines at HEAD, from the first byte of line `line` to the last byte of line `end` (or of `line`), without the line feed that ends the last line. `houserules report-facts` fills it.",
      "type": "object",
      "required": [
        "path",
        "line",
        "anchor"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "The path of the cited file, relative to the install root.",
          "$ref": "#/$defs/text"
        },
        "line": {
          "description": "The first cited line, counted from 1.",
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "description": "The last cited line, counted from 1. Leave it out to cite one line.",
          "type": "integer",
          "minimum": 1
        },
        "anchor": {
          "description": "Text of the cited lines, byte for byte, with three non-whitespace characters in a row.",
          "type": "string",
          "pattern": "\\S{3}"
        },
        "sha256": {
          "description": "The SHA-256 of the cited lines at HEAD.",
          "$ref": "#/$defs/sha256Hex"
        }
      }
    },
    "tddCycle": {
      "type": "object",
      "required": [
        "test",
        "mode",
        "red",
        "green"
      ],
      "additionalProperties": false,
      "properties": {
        "test": {
          "$ref": "#/$defs/text"
        },
        "mode": {
          "enum": [
            "natural",
            "mutation",
            "reconstructed"
          ]
        },
        "red": {
          "$ref": "#/$defs/run"
        },
        "green": {
          "$ref": "#/$defs/run"
        }
      }
    },
    "docCheck": {
      "type": "object",
      "required": [
        "api",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "api": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "dependencyVetting": {
      "type": "object",
      "required": [
        "name",
        "version",
        "evidence",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/text"
        },
        "verdict": {
          "enum": [
            "accepted",
            "rejected"
          ]
        }
      }
    },
    "coverageMeasure": {
      "type": "object",
      "required": [
        "target",
        "metric",
        "measured",
        "floor"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/text"
        },
        "metric": {
          "enum": [
            "regions",
            "lines",
            "branches"
          ]
        },
        "measured": {
          "type": "number",
          "minimum": 0
        },
        "floor": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "auditRow": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "result",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ruleId"
        },
        "kind": {
          "enum": [
            "rule",
            "invariant",
            "gotcha",
            "procedure",
            "decision",
            "history"
          ]
        },
        "mode": {
          "enum": [
            "deterministic",
            "judged"
          ]
        },
        "level": {
          "enum": [
            "fail",
            "warn",
            null
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skipped"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "sanctioned": {
          "description": "The reference that books a sanctioned row: the value of `--sanctioned <rule>=<ref>`.",
          "$ref": "#/$defs/text"
        },
        "findings": {
          "description": "The results of a runner check's tool that count, in call order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditFinding"
          }
        },
        "override": {
          "$ref": "#/$defs/rowOverride"
        }
      }
    },
    "auditFinding": {
      "description": "One result of a runner check's tool: where it is, the rule that found it, and the message of the tool. A result with no location has a null `path` and a null `line`.",
      "type": "object",
      "required": [
        "path",
        "line",
        "rule",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rule": {
          "$ref": "#/$defs/text"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "rowOverride": {
      "description": "A ruling of the person who runs the work or of the owner against the verdict of a judged row: the verdict that stands, who ruled, and why.",
      "type": "object",
      "required": [
        "result",
        "by",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "by": {
          "$ref": "#/$defs/text"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "auditSummary": {
      "type": "object",
      "required": [
        "base",
        "head",
        "deterministic",
        "pass",
        "fail",
        "warn",
        "skipped",
        "judged"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/sha"
        },
        "head": {
          "$ref": "#/$defs/sha"
        },
        "deterministic": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "judged": {
          "type": "integer",
          "minimum": 0
        },
        "empty_range": {
          "enum": [true]
        },
        "sanctioned_fail": {
          "type": "integer",
          "minimum": 1
        },
        "reference_fail": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selfAudit": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "summary",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/auditSummary"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditRow"
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "severity",
        "file",
        "what",
        "why",
        "fix"
      ],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "critical",
            "important",
            "minor"
          ]
        },
        "file": {
          "$ref": "#/$defs/text"
        },
        "what": {
          "$ref": "#/$defs/text"
        },
        "why": {
          "$ref": "#/$defs/text"
        },
        "fix": {
          "$ref": "#/$defs/text"
        },
        "rule": {
          "$ref": "#/$defs/ruleId"
        },
        "plan_mandated": {
          "type": "boolean"
        },
        "backlog": {
          "$ref": "#/$defs/backlogId"
        }
      }
    },
    "ruling": {
      "type": "object",
      "required": [
        "ruling",
        "home"
      ],
      "additionalProperties": false,
      "properties": {
        "ruling": {
          "$ref": "#/$defs/text"
        },
        "home": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "fixRound": {
      "type": "object",
      "required": [
        "round",
        "findings",
        "commits",
        "tests"
      ],
      "additionalProperties": false,
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "finding",
              "fix"
            ],
            "additionalProperties": false,
            "properties": {
              "finding": {
                "$ref": "#/$defs/text"
              },
              "fix": {
                "$ref": "#/$defs/text"
              },
              "file": {
                "$ref": "#/$defs/text"
              },
              "reran": {
                "description": "The path of the probe that the review ran to find the finding and that this round ran again, absolute or relative to the install root. Leave it out for a finding whose review gave no reproduction.",
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "gates_run": {
          "description": "The gates the round re-ran, one entry per gate: its command or its name.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "taskReport": {
      "type": "object",
      "required": [
        "kind",
        "model",
        "task",
        "backlog",
        "status",
        "implemented",
        "commits",
        "tests",
        "live_run",
        "tdd",
        "files_changed",
        "docs_verified",
        "dependency_vetting",
        "coverage",
        "self_audit",
        "self_review",
        "concerns",
        "knowledge_used"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "task-report"
          ]
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "task": {
          "$ref": "#/$defs/taskNumber"
        },
        "backlog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/backlogId"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "DONE",
            "DONE_WITH_CONCERNS",
            "BLOCKED",
            "NEEDS_CONTEXT"
          ]
        },
        "implemented": {
          "$ref": "#/$defs/text"
        },
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "live_run": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "tdd": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tddCycle"
          }
        },
        "files_changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "docs_verified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docCheck"
          }
        },
        "coverage": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/coverageMeasure"
          }
        },
        "citations": {
          "description": "The lines of files at HEAD that the claims of the report rest on, in the recorded form.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "self_audit": {
          "$ref": "#/$defs/selfAudit"
        },
        "self_review": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selfReviewItem"
          }
        },
        "concerns": {
          "$ref": "#/$defs/proseList"
        },
        "knowledge_used": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleId"
          },
          "uniqueItems": true
        },
        "fix_rounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fixRound"
          }
        },
        "rulings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruling"
          }
        },
        "dependency_vetting": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "manifests",
            "dependencies"
          ],
          "additionalProperties": false,
          "properties": {
            "manifests": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dependencyVetting"
              }
            }
          }
        }
      }
    },
    "taskReview": {
      "type": "object",
      "required": [
        "kind",
        "model",
        "task",
        "base",
        "head",
        "spec_compliance",
        "rule_adherence",
        "strengths",
        "issues",
        "assessment"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "task-review"
          ]
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "task": {
          "$ref": "#/$defs/taskNumber"
        },
        "base": {
          "$ref": "#/$defs/sha"
        },
        "head": {
          "$ref": "#/$defs/sha"
        },
        "spec_compliance": {
          "type": "object",
          "required": [
            "verdict",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "enum": [
                "compliant",
                "issues",
                "cannot-verify"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "file",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "missing",
                      "extra",
                      "misunderstood",
                      "unverifiable"
                    ]
                  },
                  "file": {
                    "$ref": "#/$defs/text"
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        },
        "rule_adherence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditRow"
          }
        },
        "strengths": {
          "$ref": "#/$defs/proseList"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "assessment": {
          "type": "object",
          "required": [
            "verdict",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "verdict": {
              "enum": [
                "approved",
                "needs-fixes"
              ]
            },
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "reReview": {
      "type": "object",
      "required": [
        "kind",
        "model",
        "task",
        "round",
        "fix_base",
        "head",
        "finding_verdicts",
        "rule_adherence",
        "new_breakage",
        "out_of_scope",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "re-review"
          ]
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "task": {
          "$ref": "#/$defs/taskNumber"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "fix_base": {
          "$ref": "#/$defs/sha"
        },
        "head": {
          "$ref": "#/$defs/sha"
        },
        "finding_verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "finding",
              "verdict",
              "evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "finding": {
                "$ref": "#/$defs/text"
              },
              "verdict": {
                "enum": [
                  "addressed",
                  "not-addressed"
                ]
              },
              "evidence": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "rule_adherence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditRow"
          }
        },
        "new_breakage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "out_of_scope": {
          "$ref": "#/$defs/proseList"
        },
        "verdict": {
          "type": "object",
          "required": [
            "state",
            "open"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "all-addressed",
                "findings-remain"
              ]
            },
            "open": {
              "$ref": "#/$defs/proseList"
            },
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "branchReview": {
      "type": "object",
      "required": [
        "kind",
        "model",
        "base",
        "head",
        "strengths",
        "issues",
        "rule_adherence",
        "recommendations",
        "retrospective",
        "assessment"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "branch-review"
          ]
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "base": {
          "$ref": "#/$defs/sha"
        },
        "head": {
          "$ref": "#/$defs/sha"
        },
        "strengths": {
          "$ref": "#/$defs/proseList"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "rule_adherence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auditRow"
          }
        },
        "recommendations": {
          "$ref": "#/$defs/proseList"
        },
        "retrospective": {
          "type": "object",
          "required": [
            "violated_rules",
            "uncovered_findings",
            "stale_entries",
            "unused_ids",
            "template_defects"
          ],
          "additionalProperties": false,
          "properties": {
            "violated_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "count",
                  "tasks",
                  "proposal"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/ruleId"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "tasks": {
                    "$ref": "#/$defs/textList"
                  },
                  "proposal": {
                    "type": "object"
                  }
                }
              }
            },
            "uncovered_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "finding",
                  "entry"
                ],
                "additionalProperties": false,
                "properties": {
                  "finding": {
                    "$ref": "#/$defs/text"
                  },
                  "entry": {
                    "type": "object",
                    "required": [
                      "id",
                      "kind",
                      "area",
                      "summary",
                      "body",
                      "tags",
                      "source"
                    ]
                  }
                }
              }
            },
            "stale_entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "edit"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/ruleId"
                  },
                  "edit": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "unused_ids": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "tasks",
                  "decision",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/ruleId"
                  },
                  "tasks": {
                    "$ref": "#/$defs/textList"
                  },
                  "decision": {
                    "enum": [
                      "keep",
                      "drop"
                    ]
                  },
                  "reason": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            },
            "template_defects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "where",
                  "what",
                  "fix"
                ],
                "additionalProperties": false,
                "properties": {
                  "where": {
                    "$ref": "#/$defs/text"
                  },
                  "what": {
                    "$ref": "#/$defs/text"
                  },
                  "fix": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        },
        "assessment": {
          "type": "object",
          "required": [
            "ready",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "ready": {
              "enum": [
                "yes",
                "no",
                "with-fixes"
              ]
            },
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    },
    "specFinding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "section",
        "what",
        "evidence",
        "fix"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "severity": {
          "enum": [
            "critical",
            "important",
            "minor"
          ]
        },
        "section": {
          "$ref": "#/$defs/text"
        },
        "what": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "$ref": "#/$defs/text"
        },
        "fix": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "specReview": {
      "type": "object",
      "required": [
        "kind",
        "model",
        "target",
        "base",
        "head",
        "strengths",
        "findings",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "spec-review"
          ]
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "target": {
          "$ref": "#/$defs/text"
        },
        "base": {
          "$ref": "#/$defs/sha"
        },
        "head": {
          "$ref": "#/$defs/sha"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "strengths": {
          "$ref": "#/$defs/proseList"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/specFinding"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "verdict",
              "probe"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "verdict": {
                "enum": [
                  "confirmed",
                  "wrong",
                  "partial"
                ]
              },
              "probe": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "controller_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "verdict",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "verdict": {
                "enum": [
                  "sound",
                  "unsound",
                  "needs-owner"
                ]
              },
              "why": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "subject",
              "where",
              "gap"
            ],
            "additionalProperties": false,
            "properties": {
              "subject": {
                "$ref": "#/$defs/text"
              },
              "where": {
                "$ref": "#/$defs/text"
              },
              "gap": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "questions_for_owner": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "recommendation"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "question": {
                "$ref": "#/$defs/text"
              },
              "recommendation": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "prior": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "verdict",
              "where"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "verdict": {
                "enum": [
                  "addressed",
                  "partial",
                  "not-addressed"
                ]
              },
              "where": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "verdict": {
          "enum": [
            "approve",
            "needs-fixes"
          ]
        }
      }
    }
  }
}
