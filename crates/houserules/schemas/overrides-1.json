{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "houserules overrides and exclusions, schema major 1",
  "description": "A project's changes to pack entries. An override replaces whole fields of one entry; a field set to null removes that field, which only an optional field allows. An exclusion drops one entry.",
  "type": "object",
  "required": [
    "schema"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^houserules/overrides@1\\.\\d+\\.\\d+$"
    },
    "overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/override"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "rule",
        "invariant",
        "gotcha",
        "procedure",
        "decision",
        "history"
      ]
    },
    "exclusion": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "override": {
      "type": "object",
      "required": [
        "id",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "$ref": "#/$defs/kind"
            },
            "area": {
              "type": "string",
              "minLength": 1
            },
            "standing": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "status": {
              "enum": [
                "active",
                "superseded",
                "retired",
                null
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "body": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "uniqueItems": true
            },
            "source": {
              "type": "object",
              "required": [
                "date",
                "by"
              ],
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "by": {
                  "enum": [
                    "user",
                    "review",
                    "controller",
                    "docs"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "see": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "verify": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "check": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "type",
                "level"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "grep-absent",
                    "commits",
                    "co-change",
                    "diff-append-only",
                    "report-field",
                    "durable-sha",
                    "runner"
                  ]
                },
                "level": {
                  "enum": [
                    "fail",
                    "warn"
                  ]
                },
                "files": {
                  "$ref": "#/$defs/glob"
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1
                },
                "flags": {
                  "type": "string"
                },
                "scope": {
                  "enum": [
                    "changed",
                    "tree"
                  ]
                },
                "subject": {
                  "type": "string",
                  "minLength": 1
                },
                "body_absent": {
                  "type": "string",
                  "minLength": 1
                },
                "body_line_max": {
                  "type": "integer",
                  "minimum": 1
                },
                "require_trailer": {
                  "type": "string",
                  "minLength": 1
                },
                "exempt_authors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "exempt_subjects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "if": {
                  "$ref": "#/$defs/glob"
                },
                "then": {
                  "$ref": "#/$defs/glob"
                },
                "per_commit": {
                  "type": "boolean"
                },
                "field": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
                },
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "non_empty": {
                  "type": "boolean"
                },
                "covers_ids": {
                  "type": "boolean"
                },
                "covers": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "glob": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
